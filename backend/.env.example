# WattLab backend configuration
# Copy to .env and adjust as needed. All values are optional (defaults shown).

# HTTP / Socket.io server
PORT=4000
CORS_ORIGIN=*

# HiveMQ Cloud broker (secure WebSockets)
MQTT_URL=wss://<cluster-id>.s1.eu.hivemq.cloud:8884/mqtt
MQTT_USERNAME=<mqtt-username>
MQTT_PASSWORD=<mqtt-password>
MQTT_TOPIC=wattlab/telemetry
#MQTT_CLIENT_ID=wattlab_backend

# Simulated telemetry feed (keeps the dashboard alive when the broker is idle).
# It auto-pauses as soon as a real MQTT packet arrives.
DEMO_ENABLED=true
DEMO_INTERVAL_MS=1600
# Days of department/workshop production history generated at boot.
DEMO_SEED_DAYS=180

# Virtual data generator — months of billing history kept for the annual audit chart.
WORKLOAD_HISTORY_MONTHS=12

# In-memory history ring buffer size
HISTORY_LIMIT=240

# Authentication (default EMS account)
AUTH_USERNAME=admin
AUTH_PASSWORD=<set-a-strong-password>
AUTH_SECRET=<random-32-byte-hex>
AUTH_TOKEN_TTL_MS=28800000

# STEG tariff & subscription audit engine
STEG_CURRENCY=DT
STEG_PRIME_RATE_DT_KVA_MONTH=8.4
STEG_ENERGY_RATE_DT_KWH=0.25
STEG_PENALTY_RATE_DT_KVA_MONTH=12.5
STEG_TOLERANCE=0.1
STEG_CONTRACTED_POWER=150
#STEG_TRANCHES=50,100,150,200,250,300,400,500,630,800,1000,1250,1600